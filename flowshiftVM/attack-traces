#!/usr/bin/env python3
"""Run the frozen simulation attacker on traffic captured from a VM benchmark.

The capture is VM1's NIC trace (VBoxManage controlvm VM1 nictrace1 on) taken while
benchmark-vms.py ran. Each TCP connection to the data port is one transfer, in the
order the benchmark log lists them. Packets from VM1 are direction 0, replies
direction 1, sizes are IP lengths; segments merged by the virtual NIC's offload
are cut back to MTU-sized packets, as a real link would carry them. Like the
dataset's flows, each transfer is kept to its first max_packets packets within
flow_seconds. As in the simulation, tunnels superimpose streams_per_tunnel such
flows of one method from time 0; each tunnel is scored on exact match against the
set of services its flows belong to.
"""
import argparse
from collections import defaultdict
from itertools import combinations
import json
from pathlib import Path
import re
import subprocess
import sys

import joblib
import numpy as np
import yaml

ROOT = Path(__file__).resolve().parent
PROJECT = ROOT.parent
sys.path.insert(0, str(PROJECT / "src"))
from features import extract_features  # noqa: E402
from train_mlp import check_compatibility, transform  # noqa: E402

WORKLOADS = {"file-transfer": "File Transfer", "streaming": "Streaming"}

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("run", type=Path, help="benchmark output folder holding the capture")
parser.add_argument("--pcap", default="vm1.pcap")
parser.add_argument("--log", type=Path, help="benchmark log (default: <run>.log)")
parser.add_argument("--config", default=str(PROJECT / "configs" / "vnat.yaml"))
parser.add_argument("--environment", default="Non VPN")
parser.add_argument("--port", type=int, default=9443)
parser.add_argument("--mtu", type=int, default=1500)
parser.add_argument("--max-packets", type=int, default=5000, help="dataset flow cap")
parser.add_argument("--flow-seconds", type=float, default=15.0, help="dataset flow cap")
args = parser.parse_args()

config_path = Path(args.config).resolve()
config = yaml.safe_load(config_path.read_text())
folder = (config_path.parent / config["data"]["root"]).resolve()
classes = config["data"]["categories"]
attacker = joblib.load((config_path.parent / config["model"]["output_root"]).resolve()
                       / folder.name / args.environment.replace(" ", "_") / "model.joblib")
check_compatibility(attacker, config)

# Transfers in the order the benchmark ran them.
log = (args.log or args.run.with_suffix(".log")).read_text()
transfers = re.findall(r"^Running (\S+), (\S+), repetition (\d+)$", log, flags=re.M)

fields = ["frame.time_epoch", "tcp.stream", "ip.src", "ip.len", "ip.hdr_len", "tcp.hdr_len"]
output = subprocess.run(
    ["tshark", "-n", "-r", str(args.run / args.pcap), "-Y", f"tcp.port=={args.port}",
     "-T", "fields", "-E", "separator=,"] + sum([["-e", f] for f in fields], []),
    capture_output=True, text=True, check=True).stdout
connections = defaultdict(list)
for line in output.splitlines():
    stamp, stream, source, length, ip_header, tcp_header = line.split(",")
    connections[int(stream)].append((float(stamp), source, int(length), int(ip_header),
                                     int(tcp_header)))
connections = sorted(connections.values(), key=lambda packets: packets[0][0])
if len(connections) != len(transfers):
    sys.exit(f"{len(connections)} connections in the capture, {len(transfers)} in the log")


def trace(packets):
    """[ns since first packet, direction, IP bytes], offload merges cut to the MTU."""
    sender, start, rows = packets[0][1], packets[0][0], []
    for stamp, source, length, ip_header, tcp_header in packets:
        headers = ip_header + tcp_header
        payload, room = length - headers, args.mtu - headers
        pieces = max(1, -(-payload // room))
        sizes = [room + headers] * (pieces - 1) + [payload - room * (pieces - 1) + headers]
        rows += [(int((stamp - start) * 1e9), int(source != sender), size) for size in sizes]
    return np.array(rows, dtype=np.int64)


flows = []
for (case, method, repetition), packets in zip(transfers, connections):
    packets_ns = trace(packets)
    kind = "streaming" if case.startswith("streaming") else "file-transfer"
    flows.append(dict(case=case, method=method, repetition=int(repetition),
                      service=classes.index(WORKLOADS[kind]),
                      packets=packets_ns[packets_ns[:, 0] < args.flow_seconds * 1e9][:args.max_packets]))

# Tunnels as in the simulation: streams_per_tunnel flows of one method, all starting
# at time 0 and observed together; every combination of distinct captured flows.
streams = config["shim"]["streams_per_tunnel"]
tunnels = []
for method in ("framing", "flowshift"):
    mine = [f for f in flows if f["method"] == method]
    for group in combinations(range(len(mine)), streams):
        merged = np.concatenate([mine[i]["packets"] for i in group])
        merged = merged[np.argsort(merged[:, 0], kind="stable")]
        truth = np.zeros(len(classes), dtype=bool)
        truth[[mine[i]["service"] for i in group]] = True
        tunnels.append(dict(method=method, flows=[f"{mine[i]['case']}#{mine[i]['repetition']}"
                                                  for i in group],
                            truth=truth, features=extract_features(merged,
                                                                   config["feature_extraction"])))

chances = attacker["classifier"].predict_proba(transform(
    np.stack([t.pop("features") for t in tunnels]), attacker["mean"], attacker["scale"],
    attacker["preprocessing"]["clip"]))
guesses = chances >= attacker["thresholds"]
for t, guess, chance in zip(tunnels, guesses, chances):
    truth = t.pop("truth")
    t.update(present=[c for c, b in zip(classes, truth) if b],
             predicted=[c for c, g in zip(classes, guess) if g], exact=bool((guess == truth).all()),
             chances=dict(zip(classes, np.round(chance, 3).tolist())))
summary = {}
for method in ("framing", "flowshift"):
    mine = [t for t in tunnels if t["method"] == method]
    summary[method] = dict(tunnels=len(mine), exact_match=float(np.mean([t["exact"] for t in mine])),
                           predicted_rate={c: float(np.mean([c in t["predicted"] for t in mine]))
                                           for c in classes})
base = summary["framing"]["exact_match"]
summary["exact_match_drop_percent"] = (100 * (1 - summary["flowshift"]["exact_match"] / base)
                                       if base else None)
result = dict(attacker=f"{folder.name}/{args.environment}", classes=classes,
              max_packets=args.max_packets, flow_seconds=args.flow_seconds,
              streams_per_tunnel=streams, summary=summary, tunnels=tunnels,
              flows=[dict(case=f["case"], method=f["method"], repetition=f["repetition"],
                          packets=len(f["packets"])) for f in flows])
(args.run / "attack.json").write_text(json.dumps(result, indent=2) + "\n")
for method in ("framing", "flowshift"):
    row = summary[method]
    print(f"{method:9s} exact match {row['exact_match']:.0%} over {row['tunnels']} tunnels; "
          "predicted present: " + ", ".join(f"{c} {r:.0%}" for c, r in row["predicted_rate"].items()))
drop = summary["exact_match_drop_percent"]
print("exact-match drop: " + (f"{drop:.1f}%" if drop is not None else "undefined (framing never right)"))
for t in tunnels:
    print(f"  {t['method']:9s} {'+'.join(t['present']):26s} -> {t['predicted']} "
          f"{'OK' if t['exact'] else 'wrong'}")
